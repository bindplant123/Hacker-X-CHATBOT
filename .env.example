# Telegram / Pyrogram
# Get these from my.telegram.org
API_ID=
API_HASH=
SESSION_STRING=

# MongoDB
# Example: mongodb+srv://username:password@cluster.mongodb.net/AlexaDb
MONGO_URL=
DATABASE_NAME=AlexaDb

# Behaviour
REPLY_DELAY=0
REPLY_TO_NORMAL_MESSAGES=true
MAX_PENDING_JOBS=1000

# Render
PORT=10000

# Arc API (cookie-free YouTube audio downloads)
ARC_API_URL=https://api.arcmusic.fun
ARC_API_KEY=

# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=VIP-ID-CHATBOT

# Voice-chat music commands: .play, .pause, .resume, .skip, .stop
